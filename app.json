{
  "expo": {
    "name": "Bubbles",
    "slug": "bubbles",
    "scheme": "bubbles",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bubbles.chat"
    },
    "android": {
      "package": "com.bubbles.chat",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#090610",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#090610",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bubbles needs access to your photos so you can share them in chats."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bubbles needs access to your microphone so you can record voice messages.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
